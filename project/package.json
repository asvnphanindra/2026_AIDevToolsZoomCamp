{
  "name": "work-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "emulators:auth": "firebase emulators:start --only auth --project work-planner-demo",
    "emulators": "firebase emulators:start --only auth,firestore --project work-planner-demo",
    "start": "node scripts/dev-start.mjs",
    "start:full": "node scripts/dev-start.mjs",
    "local": "npm start",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:vitest": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "firebase-tools": "^14.11.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
