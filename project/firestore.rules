rules_version = '2';

// Personal data: users/{uid}/… (non-anonymous only).
// Try demo: demo/{uid}/… (anonymous only; isolated per Auth uid).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isUid(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Google / non-anonymous owners — never anonymous Try-demo sessions.
    match /users/{userId} {
      allow read, write: if isUid(userId) && !isAnonymous();
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isUid(userId) && !isAnonymous();
    }

    // Anonymous Try-demo — only own demo/{uid} tree; no users/{…} access.
    match /demo/{demoUserId} {
      allow read, write: if isAnonymous() && isUid(demoUserId);
    }
    match /demo/{demoUserId}/{document=**} {
      allow read, write: if isAnonymous() && isUid(demoUserId);
    }
  }
}
