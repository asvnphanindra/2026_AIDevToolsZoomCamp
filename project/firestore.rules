rules_version = '2';

// Scaffold stubs — tighten when US-A1/A2 land for real.
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner: only signed-in user may touch their subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Demo: anonymous/demo sessions may use the shared fictional seed path.
    // Seed data must stay fictional; never put personal data here.
    match /demo/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || request.auth.token.email_verified == true);
    }
  }
}
