# Public Firebase web config (safe to commit once filled for demo project).
# Local emulators work with the scaffold defaults even if unset.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=work-planner-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=work-planner-demo
VITE_FIREBASE_STORAGE_BUCKET=work-planner-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
# Optional; npm start writes .env.local with chosen emulator ports
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8080
# Obs ingest (Compose publishes :8090); omit for UI-only
# VITE_OBS_URL=http://127.0.0.1:8090

